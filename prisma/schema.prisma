// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  // Standard Prisma Client generator for Node.js/TypeScript
  provider = "prisma-client-js"

  // Keep your custom output if you want the generated client inside your repo.
  // If you prefer the default (node_modules/@prisma/client), delete this line.
  output   = "../app/generated/prisma"
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum SubscriberSource {
  WEBSITE
  N8N
  IMPORT
  STRIPE
  BREVO
  OTHER
}

model Subscriber {
  id             String           @id @default(cuid())
  email          String?          @unique
  status         SubscriberStatus @default(ACTIVE)
  source         SubscriberSource @default(WEBSITE)

  firstName      String?
  lastName       String?
  ipHash         String?
  userAgent      String?
  consent        Boolean          @default(true)

  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, subscribedAt])
  @@index([source, subscribedAt])
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  draft
  ready
  published
}

model Article {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  excerpt      String?
  contentHtml  String
  coverImage   String?
  tags         String[]      @default([])
  status       ArticleStatus @default(draft)
  publishedAt  DateTime?
  notionPageId String?       @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt])
}
